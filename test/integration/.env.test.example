# Uptime Kuma test instance configuration
# The runner copies this file to .env.test when there is none.
#
# On a fresh test instance the runner creates the admin account from these values, so the
# defaults work as they are. Uptime Kuma wants a password of at least 6 characters with both
# letters and numbers. If the instance already has an account, these have to match it.

UPTIME_KUMA_URL=http://localhost:3001
UPTIME_KUMA_USERNAME=admin
UPTIME_KUMA_PASSWORD=integration-test-1

# Alternative: Use JWT token instead of username/password - probably not ideal for integration testing
# due to the hassle of getting the JWT token. Might as well use a simple username/password.
# UPTIME_KUMA_JWT_TOKEN=your_jwt_token_here
