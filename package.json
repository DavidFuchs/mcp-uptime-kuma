{
  "name": "@davidfuchs/mcp-uptime-kuma",
  "version": "0.0.0-dev",
  "mcpName": "io.github.DavidFuchs/mcp-uptime-kuma",
  "description": "A Model Context Protocol (MCP) server for Uptime Kuma version 2, supporting both stdio and streamable HTTP transports.",
  "type": "module",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "bin": {
    "mcp-uptime-kuma": "dist/index.js",
    "mcp-uptime-kuma-get-jwt": "dist/get-jwt.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint src test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js -t stdio",
    "start:http": "node dist/index.js -t streamable-http",
    "dev": "tsx src/index.ts",
    "dev:stdio": "tsx src/index.ts -t stdio",
    "dev:http": "tsx src/index.ts -t streamable-http",
    "watch": "tsc --watch",
    "inspector": "npx @modelcontextprotocol/inspector tsx src/index.ts",
    "test:integration": "cd test/integration && ./run-tests.sh",
    "test:integration:long": "cd test/integration && ./run-tests.sh --long",
    "test:integration:direct": "tsx test/integration/run-all.ts",
    "test:llm": "test/llm/run-llm.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docker-catalog:tools": "node scripts/docker-catalog-tools.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "typescript",
    "server",
    "stdio",
    "http",
    "uptime",
    "kuma",
    "uptime kuma"
  ],
  "author": "David Fuchs <david@davidfuchs.ca>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavidFuchs/mcp-uptime-kuma.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.22.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.10",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "fuzzysort": "^4.0.2",
    "socket.io-client": "^4.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
